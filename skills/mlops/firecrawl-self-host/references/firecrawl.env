# Example Firecrawl self-host environment file.
# Copy to .env next to docker-compose.yaml and adjust as needed.

PORT=3002
INTERNAL_PORT=3002
HOST=0.0.0.0

# DB auth is disabled in self-host by default.
USE_DB_AUTHENTICATION=***
NUM_WORKERS_PER_QUEUE=8
CRAWL_CONCURRENT_REQUESTS=10
MAX_CONCURRENT_JOBS=5
BROWSER_POOL_SIZE=5
BULL_AUTH_KEY=***

POSTGRES_USER=firecrawl
POSTGRES_PASSWORD=firecr...word
POSTGRES_DB=firecrawl
POSTGRES_HOST=nuq-postgres
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379
REDIS_RATE_LIMIT_URL=redis://redis:6379
PLAYWRIGHT_MICROSERVICE_URL=http://playwright-service:3000/scrape

LOGGING_LEVEL=info

# Local Ollama integration (optional)
OLLAMA_BASE_URL=http://host.docker.internal:11434/api
MODEL_NAME=gemma4:31b-cloud
# MODEL_EMBEDDING_NAME=nomic-embed-text
